#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/playwright-core@1.60.0/node_modules/playwright-core/node_modules:/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/playwright-core@1.60.0/node_modules:/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/playwright-core@1.60.0/node_modules/playwright-core/node_modules:/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/playwright-core@1.60.0/node_modules:/home/ubuntu/ai_geo_workbench/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../playwright-core/cli.js" "$@"
else
  exec node  "$basedir/../../../playwright-core/cli.js" "$@"
fi
