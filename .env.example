# Local server
PORT=3000
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3000

# Database
# Required for private dashboard data, Drizzle commands, and authenticated flows.
DATABASE_URL=mysql://user:password@localhost:3306/ai_geo_workbench

# Session signing
# Required for session cookies. Use a strong random value locally.
JWT_SECRET=replace-with-a-strong-local-secret

# Auth
# Local development can use the built-in dev login when NODE_ENV=development.
# Configure these only if you still need an external OAuth portal.
VITE_APP_ID=local-dev
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# OEM / white-label (single deployment; optional)
OEM_AGENCY_NAME=GEO 代运营交付系统
OEM_SYSTEM_NAME=GEO 代运营交付系统
OEM_LOGO_URL=
OEM_BRAND_COLOR=
OEM_LOGIN_TITLE=AI 可见度服务系统
OEM_LOGIN_SUBTITLE=持续提升企业在 AI 搜索中的识别、信任与推荐
OEM_LOGIN_LOGO_URL=
OEM_LOGIN_BRAND_COLOR=
OEM_REPORT_BRAND_NAME=GEO 服务团队
OEM_REPORT_LOGO_URL=
OEM_REPORT_FOOTER_TEXT=
OEM_SUPPORT_CONTACT=
OEM_POWERED_BY_VISIBLE=true
OEM_BASE_DOMAIN=
OEM_SUBDOMAIN_SLUG=
OEM_CUSTOM_DOMAIN=

# LLM provider
# Defaults to "openai" for Codex/local development. Set to "manus" only for legacy Forge deployments.
LLM_PROVIDER=openai

# Legacy Forge API
# Optional. Only required when using legacy provider features such as LLM_PROVIDER=manus,
# image generation, Data API, maps proxy, storage proxy, or presigned uploads.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# OpenAI provider
# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# For OpenAI-compatible providers such as Volcengine Ark, set OPENAI_BASE_URL to the provider root
# that already includes its API version, for example https://ark.cn-beijing.volces.com/api/v3.
OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000

# Optional proxy for OpenAI provider requests.
# HTTPS_PROXY takes precedence, then HTTP_PROXY, then ALL_PROXY.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Web search（信源 / 信任证据 AI 自动发现，Tavily）
TAVILY_API_KEY=

# AI 引擎可见度实测（豆包 / DeepSeek 复用 OPENAI_*，Kimi / 通义 / 文心单独 Key）
ARK_DEEPSEEK_MODEL_ID=
KIMI_API_KEY=
QWEN_API_KEY=
WENXIN_API_KEY=

# Analytics
# Optional. This Codex-local build does not inject an analytics script by default.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Email notifications (T0 完成 / 发布成功)
# Optional. When unset, in-app notifications still work; email sending is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Production deployment (do not commit real credentials)
# Used by `pnpm deploy:manus` and `.github/workflows/deploy-manus.yml`.
MANUS_API_BASE_URL=https://api.manus.ai/v2
MANUS_API_KEY=
MANUS_WEBSITE_ID=
MANUS_TASK_ID=
MANUS_EXPECTED_URL=https://aigeoworkb-kzxhj9uy.manus.space
MANUS_PUBLISH_VISIBILITY=public
MANUS_POLL_TIMEOUT_MS=600000
MANUS_POLL_INTERVAL_MS=15000
RUN_MIGRATIONS=false

# Railway production deployment (do not commit real credentials)
# Used by `.github/workflows/deploy-railway.yml` and Railway runtime.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT=production
RAILWAY_PRODUCTION_URL=
RAILWAY_DEPLOY_HOOK_URL=
GIT_COMMIT=
BUILD_TIME=
